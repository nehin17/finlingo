# Frontend build-time variable (set in the frontend hosting service)
VITE_API_URL=http://localhost:8080/api

# Backend runtime variables (set in the backend hosting service)
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/finlingo
DB_USERNAME=postgres
DB_PASSWORD=replace_me
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# External services
FINNHUB_API_KEY=replace_me
GEMINI_API_KEY=replace_me
GEMINI_API_MODEL=gemini-3.5-flash-lite

# Optional database behaviour
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
